# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# The ".env" file is git-ignored, so your credentials never get committed.
# -----------------------------------------------------------------------------

# Your C2 Perform login (this is a username, e.g. Jonathan.Gutierrez -- not an email)
C2_USERNAME=Your.Username
C2_PASSWORD=your-password-here

# --- Optional overrides (sensible defaults are used if left blank) ------------

# The form to select in the "Form Name" dropdown.
C2_FORM_NAME=NEW GA

# Which export layout to download. One of:
#   basic_information | basic_information_expanded | attribute_information
C2_EXPORT_TYPE=attribute_information

# How much coaching detail to export:
#   detailed = open each session's view and scrape every field -> one CSV (slower)
#   summary  = the site's quick Excel button (6 columns, fast)
C2_COACHING_MODE=detailed

# In detailed mode, cap how many sessions to scrape (0 = all). Handy for a
# quick test run before doing the full pull.
C2_COACHING_LIMIT=0

# In detailed mode, skip sessions with these Acceptance Statuses (comma-
# separated, case-insensitive). Defaults to skipping "Draft". To keep
# everything, set this to an empty value: C2_COACHING_SKIP_STATUS=
C2_COACHING_SKIP_STATUS=Draft

# Evaluation date range (mm/dd/yyyy).
# Leave C2_START_DATE blank to default to January 1st of the current year.
# Leave C2_END_DATE blank to default to today.
C2_START_DATE=
C2_END_DATE=

# Set to "false" to watch the browser work (useful the first time so you can
# complete any login challenge). Set to "true" to run invisibly.
C2_HEADLESS=false

# Where downloaded export files are saved.
C2_DOWNLOAD_DIR=downloads
